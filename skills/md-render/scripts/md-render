#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
RENDERER="$SKILL_DIR/src/render.mjs"
DEFAULTS_CONFIG="$SKILL_DIR/defaults/config.json"
GLOBAL_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/agent-skills/md-render/config.json"

# Flags
INPUT_FILE=""
OUTPUT_FILE=""
NO_OPEN=false
CONFIG_PATH=""

usage() {
  cat <<'EOF'
Usage: md-render <file|-> [options]

Render markdown as styled HTML and open in the browser.

Arguments:
  file             Markdown file to render (use - for stdin)

Options:
  --output, -o     Write HTML to file instead of temp file
  --no-open        Generate HTML but don't open browser
  --config, -c     Path to alternate config file
  --help, -h       Show this help message

Exit codes:
  0  Success
  1  Error

Examples:
  md-render docs/design.md
  md-render - < README.md
  md-render plan.md -o plan.html
EOF
}

die() { echo "Error: $1" >&2; exit 1; }

# Auto-install npm dependencies if missing
if [[ ! -d "$SKILL_DIR/node_modules/markdown-it" ]]; then
  echo "Installing dependencies..." >&2
  npm install --prefix "$SKILL_DIR" --silent >&2 || die "Failed to install dependencies. Run 'npm install' from $SKILL_DIR"
fi

# Parse args
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output|-o) OUTPUT_FILE="$2"; shift 2 ;;
    --no-open) NO_OPEN=true; shift ;;
    --config|-c) CONFIG_PATH="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    -) INPUT_FILE="-"; shift ;;
    -*) die "Unknown option: $1" ;;
    *)
      [[ -z "$INPUT_FILE" ]] || die "Unexpected argument: $1"
      INPUT_FILE="$1"; shift
      ;;
  esac
done

[[ -n "$INPUT_FILE" ]] || die "Missing input file. Use --help for usage."

# Read input
if [[ "$INPUT_FILE" == "-" ]]; then
  MARKDOWN=$(cat)
else
  [[ -f "$INPUT_FILE" ]] || die "File not found: $INPUT_FILE"
  MARKDOWN=$(cat "$INPUT_FILE")
fi

# Resolve config: --config flag > global config > defaults
if [[ -n "$CONFIG_PATH" ]]; then
  [[ -f "$CONFIG_PATH" ]] || die "Config not found: $CONFIG_PATH"
  RESOLVED_CONFIG="$CONFIG_PATH"
elif [[ -f "$GLOBAL_CONFIG" ]]; then
  RESOLVED_CONFIG="$GLOBAL_CONFIG"
else
  # First run: copy defaults to global location
  mkdir -p "$(dirname "$GLOBAL_CONFIG")"
  cp "$DEFAULTS_CONFIG" "$GLOBAL_CONFIG"
  RESOLVED_CONFIG="$GLOBAL_CONFIG"
fi

# Resolve source directory for relative link resolution
if [[ "$INPUT_FILE" != "-" ]]; then
  SOURCE_DIR="$(cd "$(dirname "$INPUT_FILE")" && pwd)"
else
  SOURCE_DIR=""
fi

# Render
HTML=$(echo "$MARKDOWN" | node "$RENDERER" "$RESOLVED_CONFIG")

# Determine output directory
USER_OUTPUT=false
if [[ -n "$OUTPUT_FILE" ]]; then
  USER_OUTPUT=true
  OUTPUT_DIR="$(cd "$(dirname "$OUTPUT_FILE")" && pwd)"
else
  OUTPUT_DIR="/tmp/md-render-$$"
  mkdir -p "$OUTPUT_DIR"
  OUTPUT_FILE="$OUTPUT_DIR/index.html"
fi

# Render linked markdown files and rewrite links
if [[ -n "$SOURCE_DIR" ]]; then
  RENDERED_LIST=""
  MD_LINKS=$(echo "$HTML" | grep -oE 'href="[^"]*\.md(#[^"]*)?"' | sed 's/href="//;s/"$//' || true)

  for link in $MD_LINKS; do
    fragment=""
    md_path="$link"
    if [[ "$link" == *"#"* ]]; then
      fragment="#${link#*#}"
      md_path="${link%%#*}"
    fi

    # Skip absolute URLs and anchors-only
    [[ "$md_path" == http://* || "$md_path" == https://* || -z "$md_path" ]] && continue

    abs_path="$SOURCE_DIR/$md_path"
    if [[ -f "$abs_path" ]]; then
      html_name="${md_path%.md}.html"
      linked_output="$OUTPUT_DIR/$html_name"

      # Only render each file once
      if [[ "$RENDERED_LIST" != *"|${md_path}|"* ]]; then
        mkdir -p "$(dirname "$linked_output")"
        LINKED_HTML=$(cat "$abs_path" | node "$RENDERER" "$RESOLVED_CONFIG")
        echo "$LINKED_HTML" > "$linked_output"
        RENDERED_LIST="${RENDERED_LIST}|${md_path}|"
      fi

      # Rewrite the link in the main HTML
      escaped_link=$(printf '%s' "$link" | sed 's/[.[\/*^$()+?{|]/\\&/g')
      HTML=$(echo "$HTML" | sed "s|href=\"${escaped_link}\"|href=\"${html_name}${fragment}\"|g")
    fi
  done
fi

# Write output
echo "$HTML" > "$OUTPUT_FILE"
if [[ "$USER_OUTPUT" == true ]]; then
  echo "Written to $OUTPUT_FILE" >&2
fi

# Open in browser
if [[ "$NO_OPEN" == false ]]; then
  if command -v open &>/dev/null; then
    open "$OUTPUT_FILE"
  elif command -v xdg-open &>/dev/null; then
    xdg-open "$OUTPUT_FILE"
  else
    echo "HTML written to $OUTPUT_FILE (no browser opener found)" >&2
  fi
fi
